<% content_for :title, t("billing.account.title") %>

<section>
  <p class="eyebrow"><%= t("billing.account.eyebrow") %></p>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink"><%= @user.full_name %></h1>
  <p class="mt-1 text-sm text-ink-muted"><%= @user.email %></p>
</section>

<% if @checkout_returned %>
  <%# The webhook, not this redirect, grants access. Until it lands the window below
      still shows what the student had before, so say so plainly. %>
  <div role="status" class="mt-6 rounded-control bg-accent-soft px-4 py-3 text-sm leading-relaxed text-accent-hover">
    <p class="font-medium"><%= t("billing.account.checkout_returned.title") %></p>
    <p class="mt-1"><%= t("billing.account.checkout_returned.body") %></p>
  </div>
<% end %>

<section class="card mt-6 px-5 py-5">
  <p class="eyebrow"><%= t("billing.access.title") %></p>
  <div class="mt-2"><%= render "billing/access_status", user: @user %></div>
  <%= link_to (@user.unlimited? ? t("billing.account.extend") : t("billing.account.see_plans")), pricing_path,
        class: "btn btn--ghost mt-4 w-full sm:w-auto" %>
</section>

<%= render "accounts/name", user: @user %>

<%= render "accounts/sign_in_methods", user: @user %>

<%= render "accounts/time_zone", user: @user %>

<%= render "accounts/reminders", user: @user %>

<section class="mt-10">
  <h2 class="text-lg font-semibold tracking-tight text-ink"><%= t("billing.account.history.title") %></h2>

  <%= render "billing/entitlements", entitlements: @entitlements %>
</section>

<p class="mt-10 text-sm text-ink-muted">
  <%= t("billing.account.help") %>
  <%= link_to t("legal.titles.refunds"), legal_path("refunds"), class: "text-accent underline underline-offset-2 hover:text-accent-hover" %>
</p>
