<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <%
    tone = case type.to_s
           when "alert", "error" then "bg-incorrect-soft text-incorrect"
           else "bg-accent-soft text-accent-hover"
           end
  %>
  <div role="status" class="mb-5 rounded-control px-4 py-3 text-sm font-medium <%= tone %>">
    <%= message %>
  </div>
<% end %>
