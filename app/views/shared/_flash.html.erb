<% flash.each do |type, message| %>
  <%# Only messages are shown here; other keys are one-time switches a page reads. %>
  <% next unless message.is_a?(String) && message.present? %>
  <%
    tone = case type.to_s
           when "alert", "error" then "bg-incorrect-soft text-incorrect"
           else "bg-accent-soft text-accent-hover"
           end
  %>
  <div role="status" class="mb-5 rounded-control px-4 py-3 text-sm font-medium <%= tone %>">
    <%= message %>
  </div>
<% end %>
