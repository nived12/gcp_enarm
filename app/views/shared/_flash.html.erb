<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <%
    tone = case type.to_s
           when "alert", "error" then "border-incorrect/40 bg-incorrect-soft text-ink"
           else "border-accent/30 bg-accent-soft text-ink"
           end
  %>
  <div role="status" class="mb-5 rounded-sm border px-4 py-3 text-sm <%= tone %>">
    <%= message %>
  </div>
<% end %>
