<header class="sticky top-0 z-30 bg-ground/85 backdrop-blur supports-[backdrop-filter]:bg-ground/70">
  <div class="mx-auto flex w-full max-w-3xl items-center gap-2 px-4 py-3 sm:px-6">
    <%= link_to root_path, class: "text-lg font-semibold tracking-tight text-ink hover:text-accent" do %>
      <%= t("app.name") %>
    <% end %>

    <div class="ml-auto flex items-center gap-1">
      <%= render "shared/theme_toggle" %>

      <% if authenticated? %>
        <%= button_to t("navigation.sign_out"), session_path, method: :delete,
              class: "min-h-11 rounded-full px-4 text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink" %>
      <% elsif !current_page?(new_session_path) %>
        <%= link_to t("navigation.sign_in"), new_session_path,
              class: "inline-flex min-h-11 items-center rounded-full bg-accent px-4 text-sm font-medium text-accent-ink hover:bg-accent-hover" %>
      <% end %>
    </div>
  </div>
</header>
