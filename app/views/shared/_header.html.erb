<header class="border-b border-line bg-ground/90 backdrop-blur supports-[backdrop-filter]:bg-ground/75 sticky top-0 z-30">
  <div class="mx-auto flex w-full max-w-3xl items-center gap-3 px-4 py-3 sm:px-6">
    <%= link_to root_path, class: "font-semibold tracking-tight text-ink hover:text-accent" do %>
      <%= t("app.name") %>
    <% end %>

    <div class="ml-auto flex items-center gap-1">
      <%= render "shared/theme_toggle" %>

      <% if authenticated? %>
        <%= button_to t("navigation.sign_out"), session_path, method: :delete,
              class: "min-h-11 rounded-sm px-3 text-sm text-ink-muted hover:text-ink" %>
      <% else %>
        <%= link_to t("navigation.sign_in"), new_session_path,
              class: "inline-flex min-h-11 items-center rounded-sm px-3 text-sm text-ink-muted hover:text-ink" %>
      <% end %>
    </div>
  </div>
</header>
