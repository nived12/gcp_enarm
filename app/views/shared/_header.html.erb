<header class="sticky top-0 z-30 bg-ground/85 backdrop-blur supports-[backdrop-filter]:bg-ground/70">
  <div class="mx-auto flex w-full <%= page_width %> items-center gap-2 px-4 py-3 sm:px-6">
    <%# The wordmark in two parts, the owner's design: GPC in ink and Enarm in indigo,
        trading colours on hover. The spans touch, so the link's text stays "GPCEnarm". %>
    <%# Signed out, the wordmark leads to the landing page, which with the hosts split is not
        on this host: the app's root sends a signed-out visitor to sign in. %>
    <%# The icon keeps its brand colours in both themes, like an app icon; it is decorative,
        so the link's accessible name stays the wordmark. %>
    <%= link_to authenticated? ? root_path : landing_root_url, class: "group flex items-center gap-2 text-lg font-semibold tracking-tight" do %>
      <%= image_tag "brand/gpcenarm-icon.svg", alt: "", width: 28, height: 28, class: "size-7 shrink-0" %>
      <span><span class="text-ink transition-colors group-hover:text-accent">GPC</span><span class="text-accent transition-colors group-hover:text-ink">Enarm</span></span>
    <% end %>

    <div class="ml-auto flex items-center gap-1">
      <%= render "shared/theme_toggle" %>

      <% if authenticated? && landing_host? %>
        <%# The marketing host shows its pages to anyone, and a signed-in reader needs only
            the way back into the app: a sign-out form posted from here would be refused. %>
        <%= link_to t("pricing.nav"), pricing_path,
              class: "hidden min-h-11 items-center rounded-full px-4 text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink sm:inline-flex" %>
        <%= link_to t("navigation.open_app"), app_host_url(root_path),
              class: "inline-flex min-h-11 items-center rounded-full bg-accent px-4 text-sm font-medium text-accent-ink hover:bg-accent-hover" %>
      <% elsif authenticated? %>
        <% if Current.user.role_admin? || Current.user.role_reviewer? %>
          <%= link_to t("navigation.admin"), admin_root_path,
                class: "hidden min-h-11 items-center rounded-full px-4 text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink sm:inline-flex" %>
        <% end %>
        <%# An icon on a phone, where the header has room for little else. %>
        <%= link_to account_path, aria: { label: t("navigation.account") },
              class: "inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink sm:px-4" do %>
          <svg class="size-5 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21a8 8 0 0 1 16 0" stroke-linecap="round"/>
          </svg>
          <span class="hidden sm:inline"><%= t("navigation.account") %></span>
        <% end %>
        <%= button_to t("navigation.sign_out"), session_path, method: :delete,
              class: "min-h-11 rounded-full px-4 text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink" %>
      <% else %>
        <% unless current_page?(pricing_path) %>
          <%= link_to t("pricing.nav"), pricing_path,
                class: "hidden min-h-11 items-center rounded-full px-4 text-sm font-medium text-ink-muted hover:bg-surface-sunk hover:text-ink sm:inline-flex" %>
        <% end %>
        <%# Sign-in is the primary button on a phone, where there is room for one: the
            landing hero carries the sign-up there. From sm up the header has both. %>
        <% show_sign_up = !current_page?(new_registration_path) %>
        <% unless current_page?(new_session_path) %>
          <%= link_to t("navigation.sign_in"), app_host_url(new_session_path),
                class: "inline-flex min-h-11 items-center rounded-full px-4 text-sm font-medium #{show_sign_up ? 'bg-accent text-accent-ink hover:bg-accent-hover sm:bg-transparent sm:text-ink-muted sm:hover:bg-surface-sunk sm:hover:text-ink' : 'bg-accent text-accent-ink hover:bg-accent-hover'}" %>
        <% end %>
        <% if show_sign_up %>
          <%= link_to t("landing.cta"), app_host_url(new_registration_path(from: "header")),
                class: "hidden min-h-11 items-center rounded-full bg-accent px-4 text-sm font-medium text-accent-ink hover:bg-accent-hover sm:inline-flex" %>
        <% end %>
      <% end %>
    </div>
  </div>
</header>
