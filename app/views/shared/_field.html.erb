<%# form, name, type, label, plus any of: autocomplete, autofocus, required, value.
    `value` is passed on only when given: an explicit nil would blank a model-backed field. %>
<div class="mb-4">
  <%= form.label name, label, class: "mb-1.5 block text-sm font-medium text-ink" %>
  <%= form.public_send(
        "#{type}_field",
        name,
        required: local_assigns.fetch(:required, true),
        autofocus: local_assigns.fetch(:autofocus, false),
        autocomplete: local_assigns[:autocomplete],
        class: "input",
        **local_assigns.slice(:value)
      ) %>
</div>
