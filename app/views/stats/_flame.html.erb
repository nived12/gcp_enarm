<%# Lit while a streak is running. An ended streak is shown in the faint ink, never in the
    error colour: losing one is quiet. %>
<svg class="<%= local_assigns.fetch(:size, "size-6") %> shrink-0 <%= lit ? "text-accent" : "text-ink-faint" %>"
     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
  <path d="M12 3c.6 3.2 4.8 5.3 4.8 10.2a4.8 4.8 0 0 1-9.6 0c0-2.3 1.1-3.8 2.3-4.8.2 1.7 1 2.8 2.1 3.2-.2-3.1-.3-5.8.4-8.6Z"
        stroke-linejoin="round" fill="<%= lit ? "currentColor" : "none" %>" fill-opacity="0.18"/>
</svg>
