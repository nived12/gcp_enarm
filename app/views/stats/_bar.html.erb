<%# One labelled row with a plain bar. The number is always written beside the bar, so the
    bar is decoration for the eye and hidden from screen readers. %>
<li class="py-3">
  <div class="flex items-baseline justify-between gap-4 text-sm">
    <span class="min-w-0 text-ink"><%= label %></span>
    <span class="numeric shrink-0 <%= percentage ? "text-ink" : "text-ink-faint" %>"><%= percentage ? score_text(percentage) : "—" %></span>
  </div>
  <div class="mt-2 h-2 overflow-hidden rounded-full bg-line" aria-hidden="true">
    <div class="h-full rounded-full bg-accent" style="width: <%= (percentage || 0).round(1) %>%"></div>
  </div>
  <p class="mt-1.5 text-xs text-ink-faint"><%= detail %></p>
</li>
