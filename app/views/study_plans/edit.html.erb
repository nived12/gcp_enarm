<% content_for :title, t("study_plans.edit.title") %>

<section>
  <%= link_to t("study_plans.back_to_calendar"), study_plan_path, class: "inline-flex min-h-11 items-center text-sm text-accent hover:text-accent-hover" %>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink"><%= t("study_plans.edit.title") %></h1>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-muted"><%= t("study_plans.edit.intro") %></p>
</section>

<%= render "form", plan: @plan, error: @error, submit: t("study_plans.edit.submit") %>

<section class="mt-10 border-t border-line pt-6">
  <p class="text-sm text-ink-muted"><%= t("study_plans.edit.start_over_body") %></p>
  <%= button_to t("study_plans.edit.start_over"), study_plan_path, method: :delete,
        class: "btn btn--ghost mt-3 w-full sm:w-auto", form: { class: "contents", data: { turbo_confirm: t("study_plans.edit.start_over_confirm") } } %>
</section>
