<%# Shown once, right after the plan is made: the moment a reminder has something to
    remind of. "Ahora no" only hides it; it does not come back either way. %>
<aside class="card mt-6 px-5 py-4" data-controller="dismissible" data-testid="reminder-invitation"
       aria-labelledby="reminder-invitation-title">
  <p id="reminder-invitation-title" class="text-sm font-medium text-ink"><%= t("reminders.invitation.title") %></p>
  <p class="mt-1 text-sm leading-relaxed text-ink-muted"><%= t("reminders.invitation.body") %></p>
  <div class="mt-3 flex flex-col gap-2 sm:flex-row">
    <%= link_to t("reminders.invitation.accept"), account_path(anchor: "reminders"), class: "btn btn--primary w-full sm:w-auto" %>
    <button type="button" class="btn btn--ghost w-full sm:w-auto" data-action="dismissible#dismiss">
      <%= t("reminders.invitation.dismiss") %>
    </button>
  </div>
</aside>
