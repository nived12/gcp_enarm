<% month = period.first %>
<%= render "period_nav",
      title: plan_date(month, :month), label: t("study_plans.show.months"),
      previous_path: (study_calendar_path(month.prev_month, "month") if month.prev_month >= plan.starts_on.beginning_of_month),
      next_path: (study_calendar_path(month.next_month, "month") if month.next_month <= plan.exam_date.beginning_of_month),
      previous_label: t("study_plans.show.previous_month"), next_label: t("study_plans.show.next_month") %>

<% if days.empty? %>
  <div class="mt-4 rounded-card border border-dashed border-line-strong p-6 text-center text-sm text-ink-muted">
    <%= t("study_plans.show.empty_month") %>
  </div>
<% else %>
  <%# A phone gets the month as a list: seven columns at 375px leave no room to name a
      topic, and naming the topics is the point. %>
  <ol class="mt-4 divide-y divide-line border-y border-line sm:hidden">
    <%= render partial: "day_row", collection: days.values, as: :day, locals: { today: today } %>
  </ol>

  <div class="mt-4 hidden grid-cols-7 gap-1 sm:grid">
    <% month.beginning_of_week(:monday).step(month.beginning_of_week(:monday) + 6).each do |weekday| %>
      <p class="eyebrow pb-1 text-center"><%= plan_date(weekday, :weekday) %></p>
    <% end %>
    <% (month.beginning_of_week(:monday)..month.end_of_month.end_of_week(:monday)).each do |date| %>
      <% day = days[date] %>
      <% if date.month != month.month %>
        <span aria-hidden="true"></span>
      <% elsif day %>
        <%= link_to study_plan_day_path(date), class: "plan-tint #{plan_day_color_class(day)} flex min-h-24 flex-col rounded-control p-1.5 text-left transition-shadow hover:ring-2 hover:ring-accent #{"ring-2 ring-accent" if date == today}" do %>
          <span class="flex items-center justify-between">
            <span class="numeric text-xs text-ink-muted"><%= date.day %></span>
            <% if day.done? %><span class="text-xs text-correct" aria-label="<%= t("study_plans.done") %>">✓</span><% end %>
          </span>
          <span class="mt-1 line-clamp-4 text-[0.6875rem] leading-tight text-ink"><%= plan_day_title(day) %></span>
        <% end %>
      <% else %>
        <span class="flex min-h-24 rounded-control p-1.5 numeric text-xs text-ink-faint"><%= date.day %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
