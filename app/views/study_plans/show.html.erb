<% content_for :title, t("study_plans.show.title") %>

<section>
  <p class="eyebrow"><%= t("study_plans.eyebrow") %></p>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink"><%= t("study_plans.show.title") %></h1>
  <p class="mt-2 text-sm text-ink-muted">
    <%= t("study_plans.show.summary", exam_date: plan_date(@plan.exam_date, :long), count: (@plan.exam_date - @today).to_i) %>
    · <%= link_to t("study_plans.show.change"), edit_study_plan_path, class: "text-accent underline underline-offset-2 hover:text-accent-hover" %>
  </p>
</section>

<% if flash[:reminder_invitation] %>
  <%= render "study_plans/reminder_invitation" %>
<% end %>

<% if @missed.positive? %>
  <%# Named plainly, with the way out beside it: the plan moves, the syllabus is not restarted. %>
  <div class="mt-6 rounded-card bg-ground-tint px-5 py-4" data-testid="behind">
    <p class="text-sm font-medium text-ink"><%= t("study_plans.show.behind", count: @missed) %></p>
    <p class="mt-1 text-sm text-ink-muted"><%= t("study_plans.show.behind_body") %></p>
    <%= button_to t("study_plans.show.catch_up"), catch_up_study_plan_path, class: "btn btn--ghost mt-3 w-full sm:w-auto", form: { class: "contents" } %>
  </div>
<% end %>

<%# Switching keeps the student where they were: today when it is on screen, otherwise
    the start of what they were looking at. %>
<% anchor = @period.cover?(@today) ? @today : @period.first %>
<nav class="mt-8 grid grid-cols-2 rounded-full bg-surface-sunk p-1 sm:inline-grid sm:w-64" aria-label="<%= t("study_plans.show.views") %>">
  <% StudyPlansController::CALENDAR_VIEWS.each do |view| %>
    <%= link_to t("study_plans.show.view.#{view}"), study_calendar_path(anchor, view),
          class: "flex min-h-11 items-center justify-center rounded-full text-sm font-medium transition-colors #{view == @view ? "bg-surface text-ink shadow-card" : "text-ink-muted hover:text-ink"}",
          aria: { current: (view == @view ? "page" : nil) } %>
  <% end %>
</nav>

<%= render @view, period: @period, days: @days, plan: @plan, today: @today %>
