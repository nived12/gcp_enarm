<section class="pt-6 pb-2">
  <p class="eyebrow"><%= t("home.landing.eyebrow") %></p>

  <h1 class="mt-3 text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl">
    <%= t("home.landing.headline_lead") %><br>
    <span class="text-accent"><%= t("home.landing.headline_accent") %></span>
  </h1>

  <p class="mt-5 max-w-prose text-base leading-relaxed text-ink-muted">
    <%= t("home.landing.subhead") %>
  </p>
</section>

<%# The thesis, shown rather than claimed: an actual graded recommendation, set the way
    the guideline sets it. Every question in this app hangs off a block like this one. %>
<figure class="mt-8 rounded-sm border border-line bg-surface p-5 sm:p-6">
  <div class="flex flex-wrap items-center gap-2">
    <span class="grade-marker grade-marker--strong">A</span>
    <span class="numeric text-xs text-ink-faint">NICE · Hong K, 2021</span>
  </div>

  <blockquote class="vignette mt-3 text-ink">
    &ldquo;<%= t("home.landing.sample_recommendation") %>&rdquo;
  </blockquote>

  <figcaption class="mt-4 border-t border-line pt-3 text-xs text-ink-faint">
    <span class="numeric">GPC IMSS-028-22</span> · <%= t("home.landing.sample_source") %>
  </figcaption>
</figure>

<p class="mt-4 text-sm leading-relaxed text-ink-muted">
  <%= t("home.landing.provenance_note") %>
</p>

<div class="mt-8 flex flex-col gap-3 sm:flex-row">
  <%= link_to t("navigation.sign_up"), new_session_path,
        class: "inline-flex min-h-12 items-center justify-center rounded-sm bg-accent px-6 font-medium text-accent-ink transition-colors hover:bg-accent-hover" %>
  <%= link_to t("navigation.sign_in"), new_session_path,
        class: "inline-flex min-h-12 items-center justify-center rounded-sm border border-line-strong px-6 font-medium text-ink transition-colors hover:border-accent hover:text-accent" %>
</div>
