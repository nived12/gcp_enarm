<section class="pt-4 sm:pt-10">
  <h1 class="text-[2.5rem] font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl">
    <%= t("home.landing.headline_lead") %><br>
    <span class="text-accent"><%= t("home.landing.headline_accent") %></span>
  </h1>

  <p class="mt-5 max-w-prose leading-relaxed text-ink-muted">
    <%= t("home.landing.subhead") %>
  </p>

  <div class="mt-7 flex flex-col gap-3 sm:flex-row">
    <%= link_to t("navigation.sign_up"), new_registration_path, class: "btn btn--primary" %>
    <%= link_to t("navigation.sign_in"), new_session_path, class: "btn btn--ghost" %>
  </div>
</section>

<%# The thesis, shown rather than claimed. Top half is a real graded recommendation
    with the exact span highlighted; bottom half is the question that span produced.
    Every question in the bank is built this way, and the review screen shows the
    same two halves — so the landing page is the product, not an advertisement. %>
<figure class="card mt-10 overflow-hidden">
  <div class="bg-ground-tint px-5 py-5 sm:px-6 sm:py-6">
    <div class="flex items-center gap-3">
      <span class="grade-marker grade-marker--strong">A</span>
      <span class="eyebrow"><%= t("home.landing.source_label") %></span>
    </div>

    <blockquote class="vignette mt-4 text-ink">
      <%= t("home.landing.sample_recommendation_html") %>
    </blockquote>

    <figcaption class="numeric mt-4 space-y-0.5 text-xs leading-relaxed text-ink-faint">
      <span class="block"><%= t("home.landing.sample_citation") %></span>
      <span class="block"><%= t("home.landing.sample_source") %></span>
    </figcaption>
  </div>

  <div class="border-t border-line px-5 py-5 sm:px-6 sm:py-6">
    <p class="eyebrow"><%= t("home.landing.derived_label") %></p>

    <p class="vignette mt-3 text-ink"><%= t("home.landing.sample_question") %></p>

    <div class="mt-4 flex items-start gap-3 rounded-control bg-correct-soft px-4 py-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-correct" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div>
        <p class="text-sm font-medium text-ink"><%= t("home.landing.sample_option") %></p>
        <p class="mt-0.5 text-xs font-medium text-correct"><%= t("home.landing.sample_option_label") %></p>
      </div>
    </div>
  </div>
</figure>

<p class="mt-4 max-w-prose text-sm leading-relaxed text-ink-muted">
  <%= t("home.landing.provenance_note") %>
</p>
