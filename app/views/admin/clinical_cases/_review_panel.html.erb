<%# On the review screen: what students reported about this case, and what can be done
    about it, above the vignette so nobody reads a reported case without knowing. %>
<% if clinical_case.status_flagged? %>
  <p class="mt-6 rounded-card border border-line-strong px-4 py-3 text-sm text-ink"><%= t("admin.clinical_cases.flagged_notice") %></p>
<% end %>

<% if open_reports.any? %>
  <section class="mt-6 rounded-card border border-incorrect bg-incorrect-soft px-5 py-4 text-sm" aria-labelledby="open-reports-title">
    <p id="open-reports-title" class="font-medium text-incorrect"><%= t("admin.clinical_cases.open_reports", count: open_reports.size) %></p>
    <ul class="mt-3 space-y-2 leading-relaxed text-ink">
      <% open_reports.each do |report| %>
        <li>
          <span class="font-medium"><%= t("review.show.question_label", number: report.question.position) %> · <%= t("question_reports.reasons.#{report.reason}") %></span>
          <% if report.comment.present? %>
            <span class="text-ink-muted">— <%= report.comment %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= link_to t("admin.clinical_cases.triage_reports"), admin_question_reports_path(case_id: clinical_case.id),
          class: "mt-2 inline-flex min-h-11 items-center text-accent underline underline-offset-2 hover:text-accent-hover" %>
  </section>
<% end %>

<div class="mt-6"><%= render "admin/clinical_cases/actions", clinical_case: clinical_case %></div>
<%= render "admin/clinical_cases/setting", clinical_case: clinical_case %>
