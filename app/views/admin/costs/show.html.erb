<%= render "admin/header", section: :costs, subtitle: t("admin.costs.subtitle") %>

<% if @rows.empty? %>
  <div class="mt-10 rounded-card border border-dashed border-line-strong p-8 text-center">
    <p class="font-medium text-ink"><%= t("admin.costs.empty.title") %></p>
    <p class="mx-auto mt-2 max-w-sm leading-relaxed text-ink-muted"><%= t("admin.costs.empty.body") %></p>
  </div>
<% else %>
  <section class="mt-8 card px-6 py-5">
    <p class="eyebrow"><%= t("admin.costs.total") %></p>
    <p class="numeric mt-3 text-3xl font-medium text-ink"><%= usd(@total.cost) %></p>
    <p class="mt-1 text-sm text-ink-muted">
      <%= t("admin.costs.total_detail", runs: number_with_delimiter(@total.runs),
            tokens: number_with_delimiter(@total.input_tokens + @total.output_tokens)) %>
    </p>
  </section>

  <section class="mt-10">
    <h2 class="eyebrow"><%= t("admin.costs.by_purpose") %></h2>
    <% widest = @by_purpose.first.last %>
    <ul class="mt-4 space-y-4">
      <% @by_purpose.each do |purpose, cost| %>
        <li>
          <div class="flex items-baseline justify-between gap-4 text-sm">
            <span class="text-ink"><%= t("admin.costs.purposes.#{purpose}") %></span>
            <span class="numeric text-ink-muted"><%= usd(cost) %></span>
          </div>
          <div class="mt-2 h-2 rounded-full bg-surface-sunk" aria-hidden="true">
            <div class="h-full rounded-full bg-accent" style="width: <%= bar_percent(cost, widest) %>%"></div>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="eyebrow"><%= t("admin.costs.by_model") %></h2>
    <div class="-mx-4 mt-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
      <table class="w-full min-w-[36rem] text-left text-sm">
        <thead class="text-xs uppercase tracking-wide text-ink-faint">
          <tr>
            <th scope="col" class="py-2 pr-4 font-medium"><%= t("admin.costs.columns.purpose") %></th>
            <th scope="col" class="py-2 pr-4 font-medium"><%= t("admin.costs.columns.model") %></th>
            <th scope="col" class="py-2 pr-4 text-right font-medium"><%= t("admin.costs.columns.runs") %></th>
            <th scope="col" class="py-2 pr-4 text-right font-medium"><%= t("admin.costs.columns.input_tokens") %></th>
            <th scope="col" class="py-2 pr-4 text-right font-medium"><%= t("admin.costs.columns.output_tokens") %></th>
            <th scope="col" class="py-2 text-right font-medium"><%= t("admin.costs.columns.cost") %></th>
          </tr>
        </thead>
        <tbody class="numeric">
          <% @rows.each do |row| %>
            <tr class="border-t border-line">
              <td class="py-2 pr-4 font-sans text-ink"><%= t("admin.costs.purposes.#{row.purpose}") %></td>
              <td class="py-2 pr-4 text-xs text-ink-muted"><%= row.provider %> · <%= row.model %></td>
              <td class="py-2 pr-4 text-right text-ink-muted"><%= number_with_delimiter(row.runs) %></td>
              <td class="py-2 pr-4 text-right text-ink-muted"><%= number_with_delimiter(row.input_tokens) %></td>
              <td class="py-2 pr-4 text-right text-ink-muted"><%= number_with_delimiter(row.output_tokens) %></td>
              <td class="py-2 text-right text-ink"><%= usd(row.cost) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="numeric">
          <tr class="border-t border-line-strong font-medium">
            <th scope="row" colspan="2" class="py-2 pr-4 font-sans text-ink"><%= t("admin.costs.total") %></th>
            <td class="py-2 pr-4 text-right text-ink"><%= number_with_delimiter(@total.runs) %></td>
            <td class="py-2 pr-4 text-right text-ink"><%= number_with_delimiter(@total.input_tokens) %></td>
            <td class="py-2 pr-4 text-right text-ink"><%= number_with_delimiter(@total.output_tokens) %></td>
            <td class="py-2 text-right text-ink"><%= usd(@total.cost) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
<% end %>
