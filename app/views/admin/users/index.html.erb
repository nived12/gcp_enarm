<%= render "admin/header", section: :users, subtitle: t("admin.users.subtitle") %>

<%= form_with url: admin_users_path, method: :get, class: "mt-8 flex gap-2", role: "search" do %>
  <%= label_tag :q, t("admin.users.search"), class: "sr-only" %>
  <%= search_field_tag :q, @query, placeholder: t("admin.users.search_placeholder"), class: "input" %>
  <%= button_tag t("admin.users.search"), name: nil, class: "btn btn--ghost shrink-0" %>
<% end %>

<% if @users.empty? %>
  <div class="mt-10 rounded-card border border-dashed border-line-strong p-8 text-center">
    <p class="font-medium text-ink"><%= t("admin.users.empty.title") %></p>
    <p class="mx-auto mt-2 max-w-sm leading-relaxed text-ink-muted"><%= t("admin.users.empty.body") %></p>
  </div>
<% else %>
  <ul class="mt-6 divide-y divide-line border-y border-line">
    <% @users.each do |user| %>
      <li>
        <%= link_to admin_user_path(user), class: "flex min-h-11 flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 text-sm hover:text-accent" do %>
          <span class="min-w-0 break-all text-ink"><%= user.email %></span>
          <span class="text-xs text-ink-faint">
            <%= t("admin.users.roles.#{user.role}") %>
            <% if user.granted_premium? %> · <%= t("admin.users.premium_until", date: l(user.granted_premium_until.to_date, format: :long)) %><% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
