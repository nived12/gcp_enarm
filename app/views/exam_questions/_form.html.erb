<%= form_with url: exam_question_answer_path(exam, exam_question.position), method: :post, class: "mt-6" do %>
  <fieldset>
    <legend class="sr-only"><%= t("exams.question.choose") %></legend>
    <div class="space-y-3" lang="<%= exam_question.clinical_case.locale %>">
      <% exam_question.answer_options.each_with_index do |option, index| %>
        <label class="flex min-h-11 cursor-pointer items-start gap-4 rounded-card border border-line bg-surface px-5 py-4 text-sm leading-relaxed transition-colors hover:border-accent has-checked:border-accent has-checked:bg-accent-soft">
          <%= radio_button_tag :answer_option_id, option.id, false, required: true,
                class: "mt-1 size-4 shrink-0 accent-accent" %>
          <span class="numeric mt-px w-4 shrink-0 font-medium text-ink-faint"><%= option_letter(index) %></span>
          <span class="text-ink"><%= option.text %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= render "exam_questions/confidence", exam_question: exam_question %>

  <%= button_tag t("exams.question.submit"), class: "btn btn--primary mt-8 w-full sm:w-auto" %>
<% end %>
