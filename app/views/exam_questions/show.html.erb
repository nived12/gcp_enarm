<%# A cached copy of a question can be out of date (the form of one since answered), and
    Turbo would show it while fetching the real page. %>
<% turbo_exempts_page_from_preview %>
<% content_for :title, t("exams.bar.position", position: @exam_question.position, total: @exam.question_count) %>
<% question = @exam_question.question %>
<% answer = @exam_question.answer %>
<% revealed = answer.present? || @exam.status_completed? %>

<%= render "exams/bar", exam: @exam,
      progress_label: t("exams.bar.position", position: @exam_question.position, total: @exam.question_count),
      progress: @exam.answers.count.fdiv(@exam.question_count) %>

<div class="mt-8">
  <%= render "case", clinical_case: @exam_question.clinical_case, question: question %>

  <article class="mt-10">
    <h1 class="text-base font-medium leading-relaxed text-ink sm:text-lg" lang="<%= @exam_question.clinical_case.locale %>">
      <%= question.text %>
    </h1>

    <% if revealed %>
      <%# Words first, then the marks: whether it was right is the first thing a student
          looks for, and it must not depend on reading a colour. %>
      <p class="mt-6 text-sm font-semibold <%= answer&.correct? ? "text-correct" : "text-incorrect" %>" role="status">
        <%= if answer.nil? then t("exams.question.unanswered")
            elsif answer.correct? then t("exams.question.right")
            else t("exams.question.wrong") end %>
      </p>
      <%= render "options_revealed", exam_question: @exam_question, answer: answer %>
      <%= render "feedback", exam_question: @exam_question %>
      <% if answer && !answer.correct? %>
        <%= render "triage", answer: answer, exam: @exam, exam_question: @exam_question %>
      <% end %>
      <%= render "question_reports/panel", exam: @exam, exam_question: @exam_question %>
    <% else %>
      <%= render "form", exam: @exam, exam_question: @exam_question %>
    <% end %>
  </article>
</div>

<%= render "navigation", exam: @exam, exam_question: @exam_question, revealed: revealed %>
<%= render "question_map", exam: @exam, current: @exam_question %>

<% if @exam.unfinished? %>
  <div class="mt-12 flex justify-center"><%= render "exams/discard", exam: @exam %></div>
<% end %>
