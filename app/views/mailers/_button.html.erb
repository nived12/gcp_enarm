<%# A table cell carries the colour so Outlook, which ignores padding on links, still
    draws a button. The link is repeated as text below for clients that strip it. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0;">
  <tr>
    <td align="center" bgcolor="#5c59f3" style="border-radius:10px;">
      <a href="<%= url %>" style="display:inline-block; padding:14px 32px; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;"><%= label %></a>
    </td>
  </tr>
</table>
