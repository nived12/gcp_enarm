<%= form_with url: exams_path, method: :post, class: "card space-y-8 px-5 py-6 sm:px-6" do %>
  <%= hidden_field_tag :mode, "custom" %>

  <%= render "shared/pill_radios", name: "filters[question_count]", id_prefix: "filters_question_count",
        legend: t("exams.new.custom.question_count"), selected: Exams::Builder::DEFAULT_CUSTOM_COUNT,
        options: Exams::Builder::CUSTOM_CHOICES.map { |count| [count, count] } %>

  <fieldset>
    <legend class="text-sm font-medium text-ink"><%= t("exams.new.custom.specialties") %></legend>
    <p class="mt-1 text-xs text-ink-faint"><%= t("exams.new.custom.none_means_all") %></p>
    <div class="mt-3 flex flex-wrap gap-2">
      <% @specialties.each do |specialty| %>
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-line-strong px-4 text-sm text-ink has-checked:border-accent has-checked:bg-accent-soft">
          <%= check_box_tag "filters[specialty_ids][]", specialty.id, false, id: "filters_specialty_#{specialty.id}", class: "accent-accent" %>
          <%= specialty.name %>
          <span class="numeric text-xs text-ink-faint"><%= @specialty_counts[specialty.id] %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= render "exams/topic_picker" %>

  <fieldset>
    <legend class="text-sm font-medium text-ink"><%= t("exams.new.custom.difficulty") %></legend>
    <div class="mt-3 flex flex-wrap gap-2">
      <% ClinicalCase.difficulties.each_key do |difficulty| %>
        <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full border border-line-strong px-4 text-sm text-ink has-checked:border-accent has-checked:bg-accent-soft">
          <%= check_box_tag "filters[difficulties][]", difficulty, false, id: "filters_difficulty_#{difficulty}", class: "accent-accent" %>
          <%= t("difficulties.#{difficulty}") %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="space-y-1">
    <legend class="sr-only"><%= t("exams.new.custom.options") %></legend>
    <% [["unseen_only", false], ["previously_wrong_only", false], ["interleave", true]].each do |name, checked| %>
      <label class="flex min-h-11 cursor-pointer items-start gap-3 py-2">
        <%= hidden_field_tag "filters[#{name}]", "0", id: nil %>
        <%= check_box_tag "filters[#{name}]", "1", checked, id: "filters_#{name}", class: "mt-1 size-4 shrink-0 accent-accent" %>
        <span>
          <span class="block text-sm font-medium text-ink"><%= t("exams.new.custom.#{name}.label") %></span>
          <span class="mt-0.5 block text-xs leading-relaxed text-ink-faint"><%= t("exams.new.custom.#{name}.hint") %></span>
        </span>
      </label>
    <% end %>
  </fieldset>

  <%= render "settings", mode: "custom", prefix: "custom" %>

  <%= button_tag t("exams.new.custom.submit"), class: "btn btn--primary w-full sm:w-auto" %>
<% end %>
