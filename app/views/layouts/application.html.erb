<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="<%= t("app.name") %>">
    <%# The browser chrome takes the page's ground: cream by day, night ink in the dark. %>
    <meta name="theme-color" content="#fffcf5" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0e0e18" media="(prefers-color-scheme: dark)">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || t("app.tagline") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Resolve the theme before first paint, or a dark-mode user gets a white flash. %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        try {
          var stored = localStorage.getItem("gpcenarm-theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {
          /* Private mode or blocked storage: fall through to the system preference. */
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alan+Sans:wght@300..900&family=Literata:opsz,wght@7..72,400..600&display=swap">

    <%= yield :head %>

    <%# The app is what installs, and a manifest only applies to pages on its own origin. %>
    <% unless landing_host? %>
      <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <% end %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-dvh bg-ground text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-control focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink">
      <%= t("navigation.skip_to_content") %>
    </a>

    <%= render "shared/header" %>

    <main id="main" class="mx-auto w-full <%= page_width %> px-4 pb-24 pt-6 sm:px-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
