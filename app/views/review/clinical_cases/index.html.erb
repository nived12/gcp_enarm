<section>
  <p class="eyebrow"><%= t("review.index.eyebrow") %></p>
  <h1 class="mt-3 text-2xl font-semibold tracking-tight text-ink"><%= t("review.index.title") %></h1>
  <p class="mt-3 max-w-prose leading-relaxed text-ink-muted"><%= t("review.index.subtitle") %></p>
</section>

<% if @verdict_counts.values.sum.positive? %>
  <%= render "verdict_filter" %>
<% end %>

<% if @cases.empty? %>
  <% empty = @verdict_counts.values.sum.positive? ? "empty_filter" : "empty" %>
  <div class="mt-10 rounded-card border border-dashed border-line-strong p-8 text-center">
    <p class="font-medium text-ink"><%= t("review.index.#{empty}.title") %></p>
    <p class="mx-auto mt-2 max-w-sm leading-relaxed text-ink-muted"><%= t("review.index.#{empty}.body") %></p>
  </div>
<% else %>
  <p class="mt-8 text-sm text-ink-faint">
    <%= t("review.index.showing", from: @pagy.from, to: @pagy.to, total: @pagy.count) %>
  </p>

  <%# Content first: the topic orients, the vignette is what she is actually judging, and
      the catalog metadata sits underneath where it does not compete with either. %>
  <ul class="mt-5 space-y-5">
    <% @cases.each do |clinical_case| %>
      <li>
        <%= link_to review_clinical_case_path(clinical_case, filters),
              class: "block rounded-card border border-line bg-surface px-6 py-5 transition hover:border-accent" do %>
          <p class="text-sm font-medium text-ink">
            <%= clinical_case.topic&.name || clinical_case.guideline&.title %>
          </p>

          <p class="mt-4 line-clamp-2 font-serif leading-relaxed text-ink-muted">
            <%= clinical_case.stem %>
          </p>

          <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-faint">
            <%= render "verdict_badge", clinical_case: clinical_case %>
            <% if clinical_case.status_retired? %>
              <span class="rounded-full border border-line-strong px-2 py-0.5 text-ink"><%= t("review.retired") %></span>
            <% end %>
            <% if (reports = @report_counts.fetch(clinical_case.id, 0)).positive? %>
              <span class="rounded-full bg-incorrect-soft px-2 py-0.5 text-incorrect"><%= t("admin.clinical_cases.open_reports", count: reports) %></span>
            <% end %>
            <span><%= t("difficulties.#{clinical_case.difficulty}") %></span>
            <span aria-hidden="true">·</span>
            <span><%= clinical_case.guideline&.catalog_key %></span>
            <% if clinical_case.guideline&.year %>
              <span aria-hidden="true">·</span>
              <span><%= clinical_case.guideline.year %></span>
            <% end %>
            <span aria-hidden="true">·</span>
            <span><%= t("review.question_count", count: clinical_case.questions.size) %></span>
            <% if clinical_case.clinical_image %>
              <span aria-hidden="true">·</span>
              <span><%= t("review.index.figure_flag", label: clinical_case.clinical_image.label) %></span>
            <% end %>
            <% if clinical_case.guideline&.expired? %>
              <span class="rounded-full bg-incorrect-soft px-2 py-0.5 text-incorrect">
                <%= t("review.index.expired_flag") %>
              </span>
            <% end %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= render "pagination" %>
<% end %>

<%# Token counts matter to whoever runs the generation, not to whoever reviews it, so
    they are here at the bottom and closed by default rather than above the cases. %>
<% if @runs.any? %>
  <details class="mt-12 border-t border-line pt-6">
    <summary class="cursor-pointer text-sm text-ink-muted hover:text-ink"><%= t("review.runs.title") %></summary>
    <table class="mt-4 w-full text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-ink-faint">
        <tr>
          <th class="py-2 pr-4 font-medium"><%= t("review.runs.model") %></th>
          <th class="py-2 pr-4 font-medium"><%= t("review.runs.cases") %></th>
          <th class="py-2 pr-4 font-medium"><%= t("review.runs.rejected") %></th>
          <th class="py-2 font-medium"><%= t("review.runs.tokens") %></th>
        </tr>
      </thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr class="border-t border-line">
            <td class="py-2 pr-4 font-mono text-xs text-ink-muted"><%= run.model %></td>
            <td class="py-2 pr-4 text-ink-muted"><%= run.cases_created %></td>
            <td class="py-2 pr-4 text-ink-muted"><%= run.rejections %></td>
            <td class="py-2 text-ink-muted"><%= number_with_delimiter(run.total_tokens) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>
