<%= link_to t("review.show.back"), review_clinical_cases_path,
      class: "text-sm text-ink-muted hover:text-accent" %>

<section class="mt-4">
  <div class="flex flex-wrap items-center gap-2">
    <%= render "shared/difficulty_badge", difficulty: @case.difficulty %>
    <% if @case.topic %>
      <span class="text-xs text-ink-muted"><%= @case.topic.name %></span>
    <% end %>
  </div>

  <%# Shown on the case rather than per question: a reviewer needs to know the guideline
      is past its validity before reading the vignette, not after, and whether any single
      question happens to cite a recommendation is beside the point. %>
  <% if @case.guideline&.expired? %>
    <p class="mt-4 rounded-card border border-incorrect px-3 py-2 text-xs text-incorrect">
      <%= t("review.show.expired_warning") %>
    </p>
  <% end %>

  <%# Serif, because a viñeta should read like a journal vignette rather than a form field. %>
  <p class="mt-4 font-serif text-lg leading-relaxed text-ink"><%= @case.stem %></p>
</section>

<% @case.questions.each do |question| %>
  <article class="mt-8 border-t border-line pt-6">
    <h2 class="text-base font-medium text-ink"><%= question.text %></h2>

    <ul class="mt-4 space-y-2">
      <% question.answer_options.each do |option| %>
        <%# Correct and incorrect must never rely on hue alone — roughly 8% of her male
            colleagues are colour-blind, and this is the one screen where misreading a
            colour costs real learning. The check mark carries the meaning; colour agrees. %>
        <li class="flex items-start gap-3 rounded-card border p-3 text-sm
                   <%= option.correct? ? "border-correct bg-correct-soft" : "border-line" %>">
          <span class="mt-0.5 w-4 shrink-0 text-center font-medium
                       <%= option.correct? ? "text-correct" : "text-ink-muted" %>">
            <%= option.correct? ? "✓" : "·" %>
          </span>
          <span class="text-ink"><%= option.text %></span>
        </li>
      <% end %>
    </ul>

    <% if question.explanation.present? %>
      <p class="mt-4 text-sm leading-relaxed text-ink-muted"><%= question.explanation %></p>
    <% end %>

    <% if question.recommendation %>
      <div class="mt-4 rounded-card bg-surface-sunk p-4">
        <p class="eyebrow"><%= t("review.show.source") %></p>

        <%# The quoted span is marked inside the full recommendation, so a reviewer can see
            at a glance whether the question used it fairly or lifted it out of context. %>
        <p class="vignette mt-2 text-sm leading-relaxed text-ink">
          <%= highlighted(question.recommendation.text, question.source_quote) %>
        </p>

        <p class="mt-3 text-xs text-ink-muted">
          <%= question.citation %>
          <% if @case.guideline %>
            · <%= @case.guideline.catalog_key %>
            · <%= @case.guideline.year || t("review.show.undated") %>
          <% end %>
        </p>

      </div>
    <% end %>
  </article>
<% end %>
