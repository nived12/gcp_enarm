<% content_for :title, t("pearls.show.title") %>

<section class="flex items-center justify-between gap-4">
  <div>
    <p class="eyebrow"><%= t("pearls.show.eyebrow") %></p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-ink"><%= t("pearls.show.title") %></h1>
  </div>
  <p class="numeric shrink-0 text-sm text-ink-faint"><%= t("pearls.show.progress", position: @step + 1, total: PearlsController::SESSION_SIZE) %></p>
</section>

<% if @pearl.nil? %>
  <div class="mt-8 rounded-card border border-dashed border-line-strong p-6 text-center">
    <p class="text-sm font-medium text-ink"><%= t("pearls.show.empty.title") %></p>
    <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-ink-muted"><%= t("pearls.show.empty.body") %></p>
    <%= link_to t("pearls.show.empty.back"), root_path, class: "btn btn--ghost mt-4" %>
  </div>
<% else %>
  <%= render "pearls/card", pearl: @pearl, step: @step %>
<% end %>
