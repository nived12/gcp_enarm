# Copy to .env for development. Nothing here is required to boot the app.
# .env is gitignored; this template is not. Never put a real key in this file.
#
# In production these are Railway service variables, not a file. See DEPLOY.md.

# --- LLM generation (Phase 2) -------------------------------------------------
# Only the two keys are needed. Provider, model and endpoint each have a default in
# app/models/llm/provider.rb, so a variable left unset degrades to a working choice
# instead of a nil in the middle of a run. `bin/rails llm:status` prints what is in
# effect and which keys are missing.

# Generator — writes the clinical cases. Defaults to gemini-3.1-flash-lite.
# LLM_API_KEY=

# Verifier — judges whether the marked-correct answer is supported by the quote.
# Defaults to deepseek-flash, a different model family on purpose: a model grading
# its own work is a much weaker check than a second opinion.
# LLM_VERIFIER_API_KEY=

# Overrides, should you want them. Valid providers: gemini, deepseek, anthropic.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_VERIFIER_PROVIDER=deepseek
# LLM_VERIFIER_MODEL=deepseek-flash
# LLM_VERIFIER_BASE_URL=https://api.deepseek.com

# --- Ingestion ----------------------------------------------------------------
# Identifies us to the GPC server and the Wayback archive. Keep a contact address
# in it: it is the only way they can reach us instead of blocking us.
# GPC_USER_AGENT=GPCEnarm/1.0 (+https://gpcenarm.com; soporte@gpcenarm.com)

# --- Access gating ------------------------------------------------------------
# FREE_DAILY_QUESTIONS=10
# TRIAL_DURATION_DAYS=14

# --- Billing (Phase 6) --------------------------------------------------------
# Every one of these is optional. Without STRIPE_SECRET_KEY the pricing page shows the
# plans with "payments available soon"; without STRIPE_WEBHOOK_SECRET every webhook is
# refused with a 400. Hosted Checkout needs no publishable key.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Sign in with Google -----------------------------------------------------
# Both unset = no "Continuar con Google" button and /auth/google_oauth2 refuses. From an
# OAuth client of type "Web application" in Google Cloud Console; its authorised
# redirect URIs must include http://localhost:3000/auth/google_oauth2/callback and
# https://app.gpcenarm.com/auth/google_oauth2/callback (the APP_HOST).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (Resend) -----------------------------------------------------------
# Sign-up verification and password resets. Production sends through Resend and needs
# all three. In development, without a key mail is caught and shown at /letter_opener,
# and the waiting page after sign-up shows the verification link; with one, mail
# really goes out.
# MAILER_FROM must be on a domain verified in Resend (Domains → Add → DNS records).
# RESEND_API_KEY=re_...
# MAILER_FROM=GPCEnarm <no-responder@gpcenarm.com>

# --- Hosts --------------------------------------------------------------------
# APP_HOST is the product's host: email links point at it. Setting LANDING_HOST as well
# splits the site: that host serves only the signed-out landing page, /pricing and
# /legal/*, and sends every other path to APP_HOST; the sign-in cookie is shared by both.
# Leave LANDING_HOST unset in development: one host, every page, as always.
# APP_HOST=app.gpcenarm.com
# LANDING_HOST=gpcenarm.com

# --- Study reminders (Web Push) ---------------------------------------------
# Unset = the "notifications on this device" option is not shown; email reminders still
# work. Generate a pair with `bin/rails web_push:generate_keys` and keep it: a new pair
# silently cuts off every browser that subscribed with the old public key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@gpcenarm.com

# --- Third party (Phase 6) ----------------------------------------------------

# Error tracking. Unset = Sentry is never initialised.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Server-side product analytics. Unset = no client is built and nothing is sent.
# Milestone events only (sign-up, exam started/finished, plan made, pearls session,
# suggestion, billing) under the user's id, never name or email. About 300 events a
# month per daily student, ~650 at worst (a hundred answers a day in 10-question
# quizzes), so PostHog's free tier (1M/month) covers 1,500+ of them.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
