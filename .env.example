# Copy to .env for development. Nothing here is required to boot the app.
# .env is gitignored; this template is not. Never put a real key in this file.
#
# In production these are Railway service variables, not a file. See DEPLOY.md.

# --- LLM generation (Phase 2) -------------------------------------------------
# Provider is swappable so the bake-off is config, not code. Gemini and DeepSeek
# both speak the OpenAI chat format, so one client serves either.
#
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
# DeepSeek: https://api.deepseek.com
#
# LLM_PROVIDER=gemini              # gemini | deepseek | anthropic
# LLM_MODEL=gemini-3.1-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=

# Verification runs on a different family than generation on purpose — a model
# grading its own work is a weaker check than a second opinion. Until there is a
# second provider's key, the hard gate is the Ruby substring check on
# source_quote, which no model can talk its way past.
# LLM_VERIFIER_PROVIDER=deepseek
# LLM_VERIFIER_MODEL=deepseek-flash
# LLM_VERIFIER_BASE_URL=https://api.deepseek.com
# LLM_VERIFIER_API_KEY=

# --- Ingestion ----------------------------------------------------------------
# Identifies us to the GPC server and the Wayback archive. Keep a contact address
# in it: it is the only way they can reach us instead of blocking us.
# GPC_USER_AGENT=GPCEnarm/1.0 (+https://gpcenarm.mx; contacto@gpcenarm.mx)

# --- Access gating ------------------------------------------------------------
# FREE_DAILY_QUESTIONS=20
# TRIAL_DURATION_DAYS=14

# --- Third party (Phase 6) ----------------------------------------------------
# STRIPE_PUBLIC_KEY=
# STRIPE_PRIVATE_KEY=
# STRIPE_SIGNING_SECRET=
# RESEND_API_KEY=
# SENTRY_DSN=
# POSTHOG_API_KEY=
